<Window x:Class="Student_Helper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team Ator's Student Helper"
        Width="1080" Height="780" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Cascadia Code, Segoe UI Variable Display, Inter, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Dynamic Color Keys -->
        <Color x:Key="OuterShellColor">#08141A26</Color>
        <Color x:Key="SidebarGlassColor">#0C1A2232</Color>
        <Color x:Key="SurfaceCardColor">#0C222B3C</Color>
        <Color x:Key="InputWellColor">#280D111A</Color>
        <Color x:Key="SubtleBorderColor">#55FFFFFF</Color>
        <Color x:Key="PopupBgColor">#F2161B24</Color>
        <Color x:Key="TextPrimaryColor">#F2F5FA</Color>
        <Color x:Key="TextMutedColor">#B0BDD0</Color>
        <Color x:Key="ButtonGlassColor">#2818E0F5</Color>
        <Color x:Key="ThemeAccentColor">#18E0F5</Color>
        <Color x:Key="ThemeAccentGlowColor">#4518E0F5</Color>
        <Color x:Key="ScrollThumbColor">#60FFFFFF</Color>

        <!-- Brushes bound to Dynamic Colors -->
        <SolidColorBrush x:Key="OuterShellBrush" Color="{DynamicResource OuterShellColor}"/>
        <SolidColorBrush x:Key="SidebarGlassBrush" Color="{DynamicResource SidebarGlassColor}"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource SurfaceCardColor}"/>
        <SolidColorBrush x:Key="InputWellBrush" Color="{DynamicResource InputWellColor}"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="{DynamicResource SubtleBorderColor}"/>
        <SolidColorBrush x:Key="PopupBgBrush" Color="{DynamicResource PopupBgColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}"/>
        <SolidColorBrush x:Key="ButtonGlassBrush" Color="{DynamicResource ButtonGlassColor}"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="{DynamicResource ThemeAccentColor}"/>
        <SolidColorBrush x:Key="ThemeAccentGlowBrush" Color="{DynamicResource ThemeAccentGlowColor}"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}"/>

        <!-- Slim Blended ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="4,2,2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource ScrollThumbBrush}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Modern Glowing Slider -->
        <Style TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3"
                                    Background="{StaticResource InputWellBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3"
                                                        Background="{StaticResource ThemeAccentBrush}"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource ThemeAccentBrush}"
                                                        BorderThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Glass Button -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGlassBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{StaticResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Top-Right Window Icon Button -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Sidebar Tab Button -->
        <Style x:Key="SidebarTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auto-Expanding Rounded TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputWellBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auto-Expanding Rounded PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputWellBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auto-Expanding ComboBox Styles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ThemeAccentGlowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{StaticResource InputWellBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Path Data="M 0 0 L 4.5 4.5 L 9 0 Z"
                                                  Fill="{StaticResource TextMutedBrush}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="12,6,30,6"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Margin="0,4,0,0"
                                        Background="{StaticResource PopupBgBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Course CheckBox -->
        <Style x:Key="CourseCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBox" Width="19" Height="19" CornerRadius="5"
                                    Background="{StaticResource InputWellBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path x:Name="chkMark" Data="M 3.5 9 L 7.5 13 L 15 5"
                                      Stroke="#FFFFFF" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBox" Property="Background" Value="{StaticResource ThemeAccentBrush}"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Character Toggle Button (B / I) -->
        <Style x:Key="CharToggleBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource InputWellBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ThemeAccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- OUTER CLEAR-GLASS SHELL -->
    <Border x:Name="OuterWindowBorder"
            CornerRadius="8"
            Background="{StaticResource OuterShellBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1.2"
            ClipToBounds="True">
        <Grid x:Name="RootWorkspaceGrid" Margin="16,10,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: HEADER BAR -->
            <Grid Grid.Row="0" Background="Transparent" Margin="2,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Margin="0,0,10,0" ToolTip="Toggle Sidebar" Click="BtnHamburger_Click">
                        <Path Data="M 0,1 L 14,1 M 0,6 L 14,6 M 0,11 L 14,11" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"/>
                    </Button>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource ThemeAccentBrush}" Margin="0,0,9,0"/>
                    <TextBlock x:Name="lblAppTitle" Text="Team Ator's Student Helper" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblAuthStatus" Text="&#x25CF; Offline" Foreground="#EB8791" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <Button x:Name="btnToggleTopBar" Content="Account &amp; Paths &#x25B2;" Style="{StaticResource GlassButton}"
                            MinHeight="28" Height="28" Padding="12,0" FontSize="12" Margin="0,0,12,0" Click="BtnToggleTopBar_Click"/>

                    <Button Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="BtnMinimize_Click">
                        <Path Data="M 0,5 L 10,5" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="BtnMaximize_Click">
                        <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="BtnClose_Click">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ROW 1: TOP BAR -->
            <Border x:Name="CardTopBar" Grid.Row="1" Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12"
                    Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="195"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Student ID:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="txtUsername" Grid.Row="0" Grid.Column="1" TextChanged="ConfigField_Changed"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Password:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="20,0,12,0"/>
                    <PasswordBox x:Name="txtPassword" Grid.Row="0" Grid.Column="3" PasswordChanged="PasswordField_Changed"/>

                    <Button x:Name="btnLogin" Grid.Row="0" Grid.Column="4" Content="Log In &amp; Sync" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="BtnLogin_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Master Folder:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="txtMasterFolderName" Grid.Row="2" Grid.Column="1" Text="Past_Questions" TextChanged="ConfigField_Changed"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Save Path:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="20,0,12,0"/>
                    <TextBox x:Name="txtSavePath" Grid.Row="2" Grid.Column="3" TextChanged="ConfigField_Changed"/>

                    <Button Grid.Row="2" Grid.Column="4" Content="Browse..." Style="{StaticResource GlassButton}" Margin="12,0,0,0" Click="BtnBrowse_Click"/>
                </Grid>
            </Border>

            <!-- ROW 2: WORKSPACE -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CardSidebar" Grid.Column="0" Background="{StaticResource SidebarGlassBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12"
                        Padding="12,10" Margin="0,0,12,0" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="lblHdrWorkspace" Text="WORKSPACE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="10,2,0,6"/>

                            <Button x:Name="btnNavPQ" Content="&#x1F4C4;  Past Questions" Style="{StaticResource SidebarTabBtn}" Margin="0,0,0,4" Click="BtnNavPQ_Click"/>
                            <Button x:Name="btnNavNotes" Content="&#x1F4DA;  Course Notes &amp; Slides" Style="{StaticResource SidebarTabBtn}" Margin="0,0,0,4" Click="BtnNavNotes_Click"/>
                            <Button x:Name="btnNavThemes" Content="&#x1F3A8;  Themes" Style="{StaticResource SidebarTabBtn}" Margin="0,0,0,4" Click="BtnNavThemes_Click"/>
                            <Button x:Name="btnNavMusic" Content="&#x1F3B5;  Music Player" Style="{StaticResource SidebarTabBtn}" Margin="0,0,0,4" Visibility="Collapsed" Click="BtnNavMusic_Click"/>
                            <Button x:Name="btnNavAbout" Content="&#x2139;  About" Style="{StaticResource SidebarTabBtn}" Margin="0,0,0,10" Click="BtnNavAbout_Click"/>

                            <Separator Background="{StaticResource SubtleBorderBrush}" Margin="4,0,4,10"/>

                            <TextBlock x:Name="lblHdrSelection" Text="SELECTION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="10,0,0,6"/>
                            <Button Content="Check All" Style="{StaticResource GlassButton}" Margin="0,0,0,5" Click="BtnCheckAll_Click"/>
                            <Button Content="Uncheck All" Style="{StaticResource GlassButton}" Margin="0,0,0,5" Click="BtnUncheckAll_Click"/>
                            <Button Content="Remove Unchecked" Style="{StaticResource GlassButton}" Margin="0,0,0,2" Click="BtnRemoveUnchecked_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12"
                        Padding="20,16" ClipToBounds="True">
                    <Grid>
                        <!-- VIEW 1: PAST QUESTIONS -->
                        <Grid x:Name="viewPastQuestions" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="transPQ" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="From Year:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbYearFrom" Grid.Column="1" SelectedIndex="0" SelectionChanged="YearRange_SelectionChanged"/>

                                <TextBlock Grid.Column="2" Text="To:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,10,0"/>
                                <ComboBox x:Name="cmbYearTo" Grid.Column="3" SelectedIndex="0"/>

                                <TextBlock Grid.Column="5" Text="Semester:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbSemester" Grid.Column="6" SelectedIndex="0">
                                    <ComboBoxItem Content="Both / All Semesters"/>
                                    <ComboBoxItem Content="First Semester Only"/>
                                    <ComboBoxItem Content="Second Semester Only"/>
                                </ComboBox>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Target Courses (Synced on Login):"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                            <Border Grid.Row="2" Background="{StaticResource InputWellBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="8" Margin="0,0,0,14">
                                <ListBox x:Name="lstPastQuestions" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource CourseCheckStyle}"
                                                      Content="{Binding DisplayText}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Button Grid.Row="3" Content="Download Past Questions"
                                    Style="{StaticResource AccentButton}" MinHeight="42" Click="BtnDownloadPQ_Click"/>
                        </Grid>

                        <!-- VIEW 2: COURSE NOTES -->
                        <Grid x:Name="viewCourseNotes" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="transNotes" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Enrolled Courses for Lecture Notes &amp; Slides (Synced on Login):"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="{StaticResource InputWellBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="8" Margin="0,0,0,14">
                                <ListBox x:Name="lstCourseNotes" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource CourseCheckStyle}"
                                                      Content="{Binding DisplayText}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Button Grid.Row="2" Content="Download Lecture Notes &amp; Slides"
                                    Style="{StaticResource AccentButton}" MinHeight="42" Click="BtnDownloadNotes_Click"/>
                        </Grid>

                        <!-- VIEW 3: THEMES & AFTER EFFECTS CHARACTER PANEL -->
                        <ScrollViewer x:Name="viewThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="transThemes" Y="0"/>
                                </Grid.RenderTransform>
                                <StackPanel Margin="4,0,8,4">
                                    <TextBlock x:Name="lblThemesHeading" Text="Themes &amp; Character" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Customize glass tint and After Effects-style workspace typography." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,18"/>

                                    <!-- 1. ACCENT SWATCHES & COLOR WHEEL -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Glass Accent Tint" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                            <StackPanel x:Name="pnlSwatches" Orientation="Horizontal"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="14,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="76" Height="76" Margin="0,0,12,0">
                                                    <Ellipse Stroke="{StaticResource SubtleBorderBrush}" StrokeThickness="1.5"/>
                                                    <Image x:Name="imgColorWheel" Width="74" Height="74" Stretch="Fill" Cursor="Cross"
                                                           MouseLeftButtonDown="ColorWheel_MouseDown"
                                                           MouseMove="ColorWheel_MouseMove"
                                                           MouseLeftButtonUp="ColorWheel_MouseUp">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="37,37" RadiusX="37" RadiusY="37"/>
                                                        </Image.Clip>
                                                    </Image>
                                                    <Canvas IsHitTestVisible="False">
                                                        <Ellipse x:Name="thumbColorWheel" Width="14" Height="14"
                                                                 Stroke="#FFFFFF" StrokeThickness="2" Fill="Transparent"
                                                                 Canvas.Left="30" Canvas.Top="30"/>
                                                    </Canvas>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center" MinWidth="145">
                                                    <TextBlock Text="Color Wheel" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Drag to tint glass" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,7"/>
                                                    <Border Background="{StaticResource ThemeAccentBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Left">
                                                        <TextBlock x:Name="lblCustomHex" Text="#18E0F5" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Separator Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,16"/>

                                    <!-- 2. AFTER EFFECTS CHARACTER / TYPOGRAPHY PANEL -->
                                    <TextBlock x:Name="lblCharSection" Text="CHARACTER &amp; TYPOGRAPHY" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Font Family" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cmbFontFamily" SelectionChanged="CmbFontFamily_SelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <Button Content="+ Import .TTF / .OTF" Style="{StaticResource GlassButton}" Padding="14,6" Click="BtnImportFont_Click"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                            <TextBlock Text="Style" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="tglBold" Style="{StaticResource CharToggleBtn}" ToolTip="Faux Bold" Margin="0,0,6,0" Click="CharStyle_Changed">
                                                    <TextBlock Text="B" FontWeight="Black" FontSize="14"/>
                                                </ToggleButton>
                                                <ToggleButton x:Name="tglItalic" Style="{StaticResource CharToggleBtn}" ToolTip="Faux Italic" Margin="0,0,10,0" Click="CharStyle_Changed">
                                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="14"/>
                                                </ToggleButton>
                                                <Button Content="Reset" Style="{StaticResource GlassButton}" Padding="14,6" Click="BtnResetTypography_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- AE Scrubbers Row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="205"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="205"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="205"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="T&#x2195;  Font Size" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="lblFontSizeVal" Text="13.5 px" FontSize="12" Foreground="{StaticResource ThemeAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="sldFontSize" Minimum="10" Maximum="18" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="13.5" ValueChanged="TypographySlider_Changed"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="A&#x2195;  Row Leading" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="lblLeadingVal" Text="6 px" FontSize="12" Foreground="{StaticResource ThemeAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="sldLineSpacing" Minimum="2" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="6" ValueChanged="TypographySlider_Changed"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="A&#x2194;  Char Spacing" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="lblTrackingVal" Text="0" FontSize="12" Foreground="{StaticResource ThemeAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="sldCharSpacing" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="TypographySlider_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- VIEW 4: SECRET MUSIC PLAYER (UNLOCKED BY 'ATOR' CHEAT CODE) -->
                        <Grid x:Name="viewMusicPlayer" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="transMusic" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock x:Name="lblMusicHeading" Text="Team Ator Secret Deck" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Cheat Code [ATOR] Activated  &#x2022;  Built-in Study &amp; Phonk Audio Deck" FontSize="12.5" Foreground="{StaticResource ThemeAccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Now Playing Card -->
                            <Border Grid.Row="1" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NOW PLAYING" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="lblNowPlaying" Text="No Track Loaded" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="lblMusicTime" Grid.Column="1" Text="00:00 / 00:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <!-- Seek Slider -->
                                    <Slider x:Name="sldMusicSeek" Minimum="0" Maximum="100" Value="0"
                                            PreviewMouseLeftButtonDown="SldMusicSeek_MouseDown"
                                            PreviewMouseLeftButtonUp="SldMusicSeek_MouseUp"
                                            Margin="0,0,0,12"/>

                                    <!-- Transport Controls -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button Content="&#x23EE; Prev" Style="{StaticResource GlassButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnMusicPrev_Click"/>
                                            <Button x:Name="btnMusicPlayPause" Content="&#x25B6; Play" Style="{StaticResource AccentButton}" Width="105" Padding="14,6" Margin="0,0,8,0" Click="BtnMusicPlayPause_Click"/>
                                            <Button Content="&#x23ED; Next" Style="{StaticResource GlassButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnMusicNext_Click"/>
                                            <ToggleButton x:Name="tglMusicLoop" Style="{StaticResource CharToggleBtn}" Width="74" IsChecked="True" ToolTip="Loop Current Track">
                                                <TextBlock Text="&#x1F501; Loop" FontSize="12" FontWeight="SemiBold"/>
                                            </ToggleButton>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F50A; Vol" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Slider x:Name="sldMusicVolume" Width="120" Minimum="0" Maximum="1" Value="0.75" ValueChanged="SldMusicVolume_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Playlist Box -->
                            <Border Grid.Row="2" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,14">
                                <ListBox x:Name="lstMusicTracks" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         MouseDoubleClick="LstMusicTracks_DoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Add Songs Button -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ Add MP3 / WAV / FLAC Tracks..." Style="{StaticResource AccentButton}" MinHeight="40" Click="BtnMusicAddTracks_Click"/>
                                <Button Grid.Column="2" Content="Play Built-In 'secret.mp3'" Style="{StaticResource GlassButton}" MinHeight="40" Click="BtnPlayBundledSecret_Click"/>
                            </Grid>
                        </Grid>

                        <!-- VIEW 5: ABOUT & LEGAL + GITHUB AUTO-UPDATER + UNINSTALLER -->
                        <ScrollViewer x:Name="viewAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="transAbout" Y="0"/>
                                </Grid.RenderTransform>
                                <StackPanel Margin="4,0,12,8">
                                    <!-- App Identity Header Card -->
                                    <Border Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="lblAboutHeading" Text="Team Ator's Student Helper" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Developed by Kingseight  &#x2022;  Team Ator" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccentBrush}" Margin="0,4,0,4"/>
                                                <TextBlock x:Name="lblAppVersion" Text="Version 1.5.0 (win-x64)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="btnCheckUpdates" Content="Check for Updates" Style="{StaticResource AccentButton}" Padding="16,6" Margin="0,0,8,0" Click="BtnCheckUpdates_Click"/>
                                                    <Button Content="Uninstall App" Style="{StaticResource GlassButton}" Foreground="#FF9AA2" Padding="14,6" Click="BtnUninstall_Click"/>
                                                </StackPanel>
                                                <TextBlock x:Name="lblUpdateStatus" Text="Up to date" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Legal Terms & Disclaimers -->
                                    <TextBlock Text="LEGAL NOTICE &amp; TERMS OF USE" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"/>

                                    <Border Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,14">
                                        <StackPanel>
                                            <TextBlock Text="1. Non-Affiliation &amp; Independent Tool" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Team Ator's Student Helper (developed by Kingseight) is an independent student productivity utility and is not officially affiliated with, endorsed by, or sponsored by the University of Professional Studies, Accra (UPSA) or Moodle Pty Ltd."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                            <TextBlock Text="2. Local Privacy &amp; Credential Security" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Your Student ID and Password are stored locally on your personal device and are transmitted strictly via encrypted HTTPS requests directly to the official UPSA Virtual learning portal. Neither Team Ator nor Kingseight collects, transmits, or stores your credentials on any external server."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                            <TextBlock Text="3. Academic Fair Use &amp; Copyright" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="All past examination papers, lecture slides, and course materials retrieved through this software remain the intellectual property of the University and their respective authors. Downloaded materials are strictly for personal academic study and revision."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                            <TextBlock Text="4. No Warranty ('As-Is' Provision)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="This software is provided 'as is' without warranty of any kind. Team Ator and Kingseight shall not be held liable for portal downtime, incomplete downloads, or account misuse."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Toast Notification -->
                        <Border x:Name="toastThemeUpdated"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{StaticResource PopupBgBrush}" BorderBrush="{StaticResource ThemeAccentBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,8" Opacity="0" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource ThemeAccentBrush}" Margin="0,0,9,0"/>
                                <TextBlock x:Name="lblToastText" Text="Theme updated" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 3: BOTTOM CONSOLE -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblProgressStatus" Grid.Row="0" Text="Ready." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>

                    <ProgressBar x:Name="progressBar" Grid.Row="1" Height="6" Background="{StaticResource InputWellBrush}"
                                 Foreground="{StaticResource ThemeAccentBrush}" BorderThickness="0" Margin="0,0,0,8"/>

                    <Border Grid.Row="2" Background="{StaticResource InputWellBrush}"
                            CornerRadius="8" Padding="10,6"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                        <TextBox x:Name="txtLog" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                 MinHeight="0" Height="Auto" Padding="0" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </Border>
                </Grid>
            </Border>

            <!-- FIRST-RUN TERMS & CONDITIONS GATE -->
            <Border x:Name="overlayTermsGate" Grid.Row="0" Grid.RowSpan="4"
                    Background="#F50D111A" BorderBrush="{StaticResource ThemeAccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="32,28" Visibility="Collapsed">
                <Grid MaxWidth="680" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="License Agreement &amp; Terms of Use" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Row="1" Text="Please review and accept the terms below to use Team Ator's Student Helper." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16"/>

                    <Border Grid.Row="2" Background="{StaticResource InputWellBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="1. Independent Utility (Non-Affiliation)" FontWeight="Bold" Foreground="{StaticResource ThemeAccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Team Ator's Student Helper is an independent student productivity tool developed by Kingseight and is not affiliated with or endorsed by UPSA or Moodle Pty Ltd." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="2. Local Credential Privacy" FontWeight="Bold" Foreground="{StaticResource ThemeAccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Your Student ID and Password stay strictly on your local machine and are transmitted only to the official UPSA Virtual portal via HTTPS." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="3. Academic Fair Use &amp; As-Is Warranty" FontWeight="Bold" Foreground="{StaticResource ThemeAccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Downloaded past questions and slides are strictly for personal study. This software is provided 'as-is' without warranty of any kind." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <CheckBox x:Name="chkAcceptTerms" Grid.Row="3" Style="{StaticResource CourseCheckStyle}"
                              Content="I have read and agree to the Terms and Conditions"
                              Margin="0,16,0,20" Checked="ChkAcceptTerms_Changed" Unchecked="ChkAcceptTerms_Changed"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Decline &amp; Exit" Style="{StaticResource GlassButton}" Margin="0,0,12,0" Click="BtnDeclineTerms_Click"/>
                        <Button x:Name="btnContinueTerms" Content="Accept &amp; Continue" Style="{StaticResource AccentButton}" IsEnabled="False" Click="BtnAcceptTerms_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>